<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="ComputeSharpDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComputeSharpDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shaders="using:ComputeSharpDemo.Shaders"
    xmlns:winex="using:WinUIEx"
    Title="ComputeSharp Demo"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Margin="0,32,0,0"
        RowDefinitions="Auto,*"
        SizeChanged="OnRootGridSizeChanged">
        <!--  Toolbar  -->
        <Grid
            Grid.Row="0"
            Margin="12,8"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <ComboBox
                x:Name="ShaderSelector"
                Grid.Column="0"
                MinWidth="240"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                SelectionChanged="OnShaderSelected" />
            <TextBlock
                x:Name="AuthorText"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="HdrStatusText"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ToggleSwitch
                x:Name="HdrToggle"
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsEnabled="False"
                Toggled="OnHdrToggled" />
            <TextBlock
                x:Name="FrameCountText"
                Grid.Column="4"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!--
            GPU surface. SwapChainPanel displays swapchain buffer pixels as DIPs
            (WinUI bug #8219): the host is sized to the physical pixel size so the
            full buffer is visible, and the panel is counter-scaled by 1/DpiScale
            to fit the layout again (the panel itself always arranges at its slot size).
        -->
        <Canvas x:Name="PanelHost" Grid.Row="1" />
    </Grid>
</winex:WindowEx>
