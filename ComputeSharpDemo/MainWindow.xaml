<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ComputeSharpDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ComputeSharpDemo"
    xmlns:shaders="using:ComputeSharpDemo.Shaders"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ComputeSharp Demo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" SizeChanged="OnRootGridSizeChanged">
        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="12,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <ComboBox x:Name="ShaderSelector"
                      Grid.Column="0"
                      MinWidth="240"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnShaderSelected" />
            <TextBlock x:Name="AuthorText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13" />
            <TextBlock x:Name="HdrStatusText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13" />
            <ToggleSwitch x:Name="HdrToggle"
                          Grid.Column="3"
                          Header="HDR"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          IsEnabled="False"
                          Toggled="OnHdrToggled" />
            <TextBlock x:Name="FrameCountText"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13" />
        </Grid>

        <!-- GPU surface. SwapChainPanel displays swapchain buffer pixels as DIPs
             (WinUI bug #8219): the host is sized to the physical pixel size so the
             full buffer is visible, and the panel is counter-scaled by 1/DpiScale
             to fit the layout again (the panel itself always arranges at its slot size). -->
        <Canvas x:Name="PanelHost" Grid.Row="1" />
    </Grid>
</Window>
